
#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<int> a(n);
        long long sum = 0;

        for (int i = 0; i < n; i++) {
            cin >> a[i];
            sum += a[i];
        }

        int mini = INT_MAX;

        for (int i = 0; i < n - 1; i++) {
            mini = min(mini, a[i] + a[i + 1]);
        }

        cout << sum - mini / 2 << endl;
    }

    return 0;
}
