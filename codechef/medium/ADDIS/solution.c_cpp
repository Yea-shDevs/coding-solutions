#include <bits/stdc++.h>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        map<int, int> freq;

        for (int i = 0; i < N; i++) {
            int x;
            cin >> x;
            freq[x]++;
        }

        int maxFreq = 0;

        for (auto it : freq) {
            maxFreq = max(maxFreq, it.second);
        }

        cout << (maxFreq + 1) / 2 << "\n";
    }

    return 0;
}