#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int A, B, P, Q, R;
        cin >> A >> B >> P >> Q >> R;

        int ans = 1000000;

        for (int k = 0; k <= min(A, B); k++) {
            int right = A - k;
            int up = B - k;

            int rightMoves = (right + 1) / 2;
            int upMoves = (up + 1) / 2;

            int cost = k * R + rightMoves * P + upMoves * Q;

            ans = min(ans, cost);
        }

        cout << ans << endl;
    }

    return 0;
}