#include <iostream>
#include <string>
#include <cmath>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        string S;
        cin >> S;

        int x = 0, y = 0;

        for (char ch : S) {
            if (ch == 'U')
                y++;
            else if (ch == 'D')
                y--;
            else if (ch == 'L')
                x--;
            else if (ch == 'R')
                x++;
        }

        if (abs(x) + abs(y) == 2)
            cout << "YES" << endl;
        else
            cout << "NO" << endl;
    }

    return 0;
}
