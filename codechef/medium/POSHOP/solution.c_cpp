#include <iostream>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        int C[100];

        for (int i = 0; i < N; i++) {
            cin >> C[i];
        }

        int ans = 0;

        // Buying only one item
        for (int i = 0; i < N; i++) {
            ans = max(ans, C[i]);
        }

        // Buying two items
        for (int i = 0; i < N; i++) {
            for (int j = i + 1; j < N; j++) {
                if (C[i] <= C[j]) {
                    ans = max(ans, C[i] + C[j]);
                }
            }
        }

        cout << ans << endl;
    }

    return 0;
}