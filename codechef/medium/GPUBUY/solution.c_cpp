#include <iostream>
using namespace std;

int main() {
    int T;
    cin >> T;
    while (T--) {
        int X, Y, Z;
        cin >> X >> Y >> Z;

        if (Z <= Y) {
            cout << -1 << endl;
        } else {
            // Formula to divide X by (Z - Y) and round UP:
            int months = (X + (Z - Y) - 1) / (Z - Y);
            cout << months << endl;
        }
    }
    return 0;
}
