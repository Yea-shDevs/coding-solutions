#include <bits/stdc++.h>
using namespace std;

int main()
{
    int T;
    cin >> T;
    while (T--)
    {
        int X, Y, Z;
        cin >> X >> Y >> Z;
        int i = 1, flag = 0;
        while (i < 13)
        {
            if ((X + i*Y) <= i*Z)
            {
                cout << i<<endl;
                flag = 1;
                break;
            }
            i++;
        }
        if( flag!=1)
        cout<<-1<<endl;
    }

}