#include <iostream>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N, M, K;
        cin >> N >> M >> K;

        bool occupied[100005] = {false};

        // Mark already occupied seats
        for (int i = 0; i < M; i++) {
            int x;
            cin >> x;
            occupied[x] = true;
        }

        // Find seats for K new people
        int count = 0;

        for (int seat = 1; seat <= N && count < K; seat++) {
            if (!occupied[seat]) {
                cout << seat << " ";
                occupied[seat] = true;
                count++;
            }
        }

        cout << endl;
    }

    return 0;
}