#include <iostream>
#include <string>
using namespace std;

int main() {
    int T;
    cin >> T;

    while (T--) {
        int N;
        cin >> N;

        string A, B;
        cin >> A >> B;

        int countA = 0, countB = 0;

        for (char ch : A) {
            if (ch == '1')
                countA++;
        }

        for (char ch : B) {
            if (ch == '1')
                countB++;
        }

        if (countA % 2 == countB % 2)
            cout << "YES" << endl;
        else
            cout << "NO" << endl;
    }

    return 0;
}