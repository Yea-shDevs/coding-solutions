#include <bits/stdc++.h>
using namespace std;

int main() {
    string s1, s;
    cin >> s1;

    int count = 0;

    for (int i = 0; i < s1.size() / 2; i++) {
        count++;
        s = s1[i] + s;
    }

    if (count == 4 && s == s1.substr(2, 2))
        cout << "YES";
    else
        cout << "NO";

    return 0;
}