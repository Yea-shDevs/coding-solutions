#include <stdio.h>

int main()
{
    int t;
    if (scanf("%d", &t) != 1) 
    return 0;
    
    while (t--)
    {
        int N, M;
        scanf("%d %d", &N, &M);
        
        if (M == 2 * N)
        {
            printf("%d\n", N);
        }
        else if(N>M) 
        {
            printf("%d\n", 2 * N - M);
        }
        else if(N<M){
                        printf("%d\n", N );

        }
    }
    return 0;
}
