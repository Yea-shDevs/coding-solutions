#include <bits/stdc++.h>
using namespace std;

int main() {
   int t;
   cin>>t;
   while(t--){
        int a,b,c;
        cin>>a>>b>>c;
        if (a>=c && a<=b)
            cout<<"Yes"<<endl;
        if(a<=c && c<=b)
            cout<<"Yes"<<endl;
        else if(a>b || c>b)
        cout<<"no"<<endl;
    
        
   }

}
