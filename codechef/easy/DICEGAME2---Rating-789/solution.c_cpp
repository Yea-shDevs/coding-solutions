#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin >> t;

    while(t--) {
        int a1, a2, a3, b1, b2, b3;
        cin >> a1 >> a2 >> a3 >> b1 >> b2 >> b3;

        int min1 = min(a1, min(a2, a3));
        int min2 = min(b1, min(b2, b3));

        int alice = a1 + a2 + a3 - min1;
        int bob = b1 + b2 + b3 - min2;

        if(alice > bob)
            cout << "Alice" << endl;
        else if(alice < bob)
            cout << "Bob" << endl;
        else
            cout << "Tie" << endl;
    }
}